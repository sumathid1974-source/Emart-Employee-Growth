# ==============================================================================
# EmployeeHub — Production Environment Configuration (.env.example)
# IMPORTANT: Copy this file to .env and fill in real values.
# Do NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Application Base URLs
APP_URL=https://hub.yourcompany.com
API_URL=https://hub.yourcompany.com/api

# Database Engine Selection ('sqlite' for embedded development, 'postgres' for scalable production)
DB_CLIENT=postgres

# PostgreSQL Connection String (Required when DB_CLIENT=postgres)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://employeehub_user:REPLACE_WITH_SECURE_PASSWORD@db.internal:5432/employeehub_db

# Local SQLite Path (Fallback for standalone edge installations)
SQLITE_DB_PATH=./employeehub.db

# Authentication Secrets (Must be at least 32 cryptographically secure random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_HEX_OR_BASE64_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_EXPIRES_IN=24h
COOKIE_SECRET=REPLACE_WITH_RANDOM_COOKIE_ENCRYPTION_SECRET_32_CHARS

# Security & CORS Settings
# Comma-separated list of trusted client origins
CORS_ORIGIN=https://hub.yourcompany.com

# Session Cookie Options
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# Rate Limiting Parameters
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=200

# Logging & Observability
LOG_LEVEL=info
ENABLE_AUDIT_LOG_ARCHIVE=true

# Organization Defaults
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
